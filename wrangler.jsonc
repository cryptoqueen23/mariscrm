{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariscrm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mariscrm-db",
      "database_id": "5913e4be-8c19-4a06-9d1d-bb3ed2c5d482",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Mari CRM",
    "APP_ORIGIN": "http://localhost:8787"
  }
}
